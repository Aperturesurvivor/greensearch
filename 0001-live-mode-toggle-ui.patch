+/* ── Mode toggle (header pills) ── */
+.mode-toggle {
+  display: inline-flex; align-items: center; gap: 0;
+  background: rgba(255,255,255,.06); border-radius: 6px;
+  padding: 2px; cursor: pointer; position: relative;
+}
+.mode-toggle .mt-opt {
+  font-size: 10px; font-weight: 600; font-family: var(--font-mono);
+  padding: 3px 10px; border-radius: 4px; letter-spacing: .08em;
+  text-transform: uppercase; cursor: pointer; transition: all .2s;
+  color: var(--ink3); background: transparent; border: none;
+  line-height: 1.4;
+}
+.mode-toggle .mt-opt.active-demo {
+  background: var(--pill-bg); color: var(--pill-fg);
+}
+.mode-toggle .mt-opt.active-live {
+  background: var(--teal); color: var(--on-accent);
+}
+.mode-toggle .mt-opt:hover:not(.active-demo):not(.active-live) {
+  color: var(--ink2);
+}
+[data-theme="light"] .mode-toggle { background: rgba(0,0,0,.06) }
+
+/* ── Settings popover ── */
+.settings-pop {
+  position: absolute; top: calc(100% + 8px); right: 0;
+  background: var(--surface); border: 1px solid var(--border2);
+  border-radius: var(--r); padding: 16px 18px; min-width: 320px;
+  box-shadow: 0 8px 32px rgba(0,0,0,.4); z-index: 100;
+  opacity: 0; pointer-events: none; transform: translateY(-4px);
+  transition: opacity .15s, transform .15s;
+}
+.settings-pop.open { opacity: 1; pointer-events: auto; transform: translateY(0) }
+.settings-pop .sp-title {
+  font-size: 11px; font-weight: 600; font-family: var(--font-mono);
+  text-transform: uppercase; letter-spacing: .06em; color: var(--ink3);
+  margin-bottom: 10px;
+}
+.settings-pop .sp-row {
+  display: flex; flex-direction: column; gap: 4px; margin-bottom: 12px;
+}
+.settings-pop .sp-row:last-child { margin-bottom: 0 }
+.settings-pop .sp-label {
+  font-size: 12px; font-weight: 500; color: var(--ink2);
+}
+.settings-pop .sp-input {
+  width: 100%; background: var(--bg); border: 1px solid var(--border);
+  color: var(--ink); border-radius: var(--rs); padding: 8px 10px;
+  font: 12px var(--font-mono); outline: none; transition: border-color .2s;
+}
+.settings-pop .sp-input:focus { border-color: var(--teal) }
+.settings-pop .sp-check {
+  display: flex; align-items: center; gap: 8px; font-size: 12px;
+  color: var(--ink2); cursor: pointer;
+}
+.settings-pop .sp-check input {
+  width: 15px; height: 15px; accent-color: var(--teal); cursor: pointer;
+}
+.settings-pop .sp-note {
+  font-size: 11px; color: var(--ink3); line-height: 1.4;
+}
+@media(max-width:540px) {
+  .settings-pop { min-width: 280px; right: -8px }
+}
