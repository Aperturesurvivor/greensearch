# Arboris live backend settings (server/app.py).
# Copy to .env (already git-ignored) and fill in locally. NEVER commit a real key.
# The server reads these from the process environment; it does not load .env
# itself. One way:  set -a; . ./.env; set +a; python3 server/app.py
#
# Placeholder values only. Leaving ARBORIS_API_KEY empty keeps the server
# in "not configured" mode: /api/chat answers 503 and no provider is called.

ARBORIS_API_KEY=
ARBORIS_BASE_URL=https://openrouter.ai/api/v1
# Primary model: a named general chat model. Not openrouter/free: that router
# can pick non-chat free models (a content-safety model once answered a
# hamburger question with "User Safety: safe"), and fallback only triggers on
# errors, not on wrong-type answers. Free models are rate-limited and rotate.
# (qwen/qwen3-8b, an older default, was deprecated on OpenRouter on 2026-10-09.)
ARBORIS_MODEL=google/gemma-4-31b-it:free
# Tried in order when the primary call fails with HTTP 429/404/502/503, or
# 402 (no credits) when the next model is free. 401 (bad key) never falls
# back. Comma-separated; "none" disables. Empty uses this same default list.
# openrouter/free stays last, as a last resort only.
ARBORIS_MODEL_FALLBACKS=liquid/lfm-2.5-2.6b:free,thinkingmachines/inkling-small:free,poolside/laguna-xs-2.1:free,openrouter/free
# Optional. Leave empty (or equal to ARBORIS_MODEL) for no escalation call.
# Only a DIFFERENT model id here turns on the logprob-gated cascade.
ARBORIS_ESCALATION_MODEL=
# Only used when the cascade is on.
ARBORIS_CASCADE_THRESHOLD=-1.0
# Exact origins, separated by commas and/or spaces. Trailing slashes are
# stripped. '*' is refused.
ARBORIS_BACKEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000
ARBORIS_RATE_LIMIT_PER_HOUR=100
# Off by default. When on, prompts are logged to local stderr only.
ARBORIS_DEBUG_LOG=
PORT=8000
