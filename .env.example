# GreenSearch live backend settings (server/app.py).
# Copy to .env (already git-ignored) and fill in locally. NEVER commit a real key.
# The server reads these from the process environment; it does not load .env
# itself. One way:  set -a; . ./.env; set +a; python3 server/app.py
#
# Placeholder values only. Leaving GREENSEARCH_API_KEY empty keeps the server
# in "not configured" mode: /api/chat answers 503 and no provider is called.

GREENSEARCH_API_KEY=
GREENSEARCH_BASE_URL=https://openrouter.ai/api/v1
# Single primary model. Every request is one call to this model.
GREENSEARCH_MODEL=qwen/qwen3-8b
# Optional. Leave empty (or equal to GREENSEARCH_MODEL) for no escalation call.
# Only a DIFFERENT model id here turns on the logprob-gated cascade.
GREENSEARCH_ESCALATION_MODEL=
# Only used when the cascade is on.
GREENSEARCH_CASCADE_THRESHOLD=-1.0
# Comma-separated exact origins. '*' is refused.
GREENSEARCH_BACKEND_ORIGIN=http://localhost:8000,http://127.0.0.1:8000
GREENSEARCH_RATE_LIMIT_PER_HOUR=100
# Off by default. When on, prompts are logged to local stderr only.
GREENSEARCH_DEBUG_LOG=
PORT=8000
