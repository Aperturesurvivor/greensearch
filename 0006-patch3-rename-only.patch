+"""Arboris: a low-carbon GPT-wrapper harness.
+
+Modes (sprout/canopy/full) control answer length; the brevity layer trims
+draft answers to a sentence budget; token and CO2e figures are ESTIMATES
+from token counts, not measurements. See README.md for the honest limits.
+"""
+
+__version__ = "0.9.0"
